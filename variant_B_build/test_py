"""Tests for var1.Solution — CLI robot simulator (variation 1) and extensible commands (variation 2)."""

import runpy
import unittest
from unittest.mock import patch

from var1 import Solution


def _inputs(*commands):
  """Build a mocked input sequence that ends the interactive loop."""
  return list(commands) + [EOFError]


class TestRobotSim(unittest.TestCase):
  """Edge-case coverage for interactive robot_sim."""

  def test_no_commands_stays_at_origin(self):
    with patch("builtins.input", side_effect=_inputs()):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 0))

  def test_single_move_north(self):
    with patch("builtins.input", side_effect=_inputs("move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 1))

  def test_print_after_move_only(self):
    with patch("builtins.input", side_effect=_inputs("move")), patch(
      "builtins.print"
    ) as mock_print:
      Solution.robot_sim("")
    mock_print.assert_called_once_with("(0, 1)")

  def test_multiple_moves_north(self):
    with patch("builtins.input", side_effect=_inputs("move", "move", "move", "move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 4))

  def test_turn_then_move_east(self):
    with patch("builtins.input", side_effect=_inputs("turn", "move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (1, 0))

  def test_turn_twice_then_move_south(self):
    with patch("builtins.input", side_effect=_inputs("turn", "turn", "move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, -1))

  def test_turn_three_times_then_move_west(self):
    with patch("builtins.input", side_effect=_inputs("turn", "turn", "turn", "move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (-1, 0))

  def test_four_turns_full_rotation_no_move(self):
    with patch(
      "builtins.input", side_effect=_inputs("turn", "turn", "turn", "turn")
    ):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 0))

  def test_turn_does_not_print(self):
    with patch("builtins.input", side_effect=_inputs("turn")), patch(
      "builtins.print"
    ) as mock_print:
      Solution.robot_sim("")
    mock_print.assert_not_called()

  def test_only_turns_no_movement(self):
    with patch(
      "builtins.input", side_effect=_inputs("turn", "turn", "turn", "turn")
    ):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 0))

  def test_turn_then_two_moves_east(self):
    with patch("builtins.input", side_effect=_inputs("turn", "move", "move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (2, 0))

  def test_square_path_returns_to_origin(self):
    cmds = [
      "move",
      "move",
      "turn",
      "move",
      "move",
      "turn",
      "move",
      "move",
      "turn",
      "move",
      "move",
    ]
    with patch("builtins.input", side_effect=_inputs(*cmds)):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 0))

  def test_ignored_invalid_commands(self):
    with patch(
      "builtins.input", side_effect=_inputs("foo", "move", "bar", "!@#")
    ), patch("builtins.print") as mock_print:
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 1))
    mock_print.assert_called_once_with("(0, 1)")

  def test_empty_line_exits_with_current_position(self):
    with patch("builtins.input", side_effect=[""]):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 0))

  def test_move_before_eof(self):
    with patch("builtins.input", side_effect=_inputs("move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (0, 1))

  def test_called_on_instance(self):
    with patch("builtins.input", side_effect=_inputs("move", "move")):
      solution = Solution()
      result = solution.robot_sim("")
    self.assertEqual(result, (0, 2))

  def test_main_entrypoint(self):
    with patch("builtins.input", side_effect=EOFError), patch(
      "builtins.print"
    ) as mock_print:
      runpy.run_path("var1.py", run_name="__main__")
    mock_print.assert_called_once_with((0, 0))


class TestExtensibleCommands(unittest.TestCase):
  """Variation 2: execute/position API and extensible command dictionary."""

  def test_execute_turn_and_move(self):
    robot = Solution()
    robot.execute("turn")
    with patch("builtins.print") as mock_print:
      robot.execute("move")
    self.assertEqual(robot.position(), (1, 0))
    mock_print.assert_called_once_with("(1, 0)")

  def test_execute_ignores_unknown_commands(self):
    robot = Solution()
    with patch("builtins.print") as mock_print:
      robot.execute("jump")
      robot.execute("")
    self.assertEqual(robot.position(), (0, 0))
    mock_print.assert_not_called()

  def test_position_without_printing(self):
    robot = Solution()
    robot.execute("move")
    self.assertEqual(robot.position(), (0, 1))

  def test_custom_command_via_dictionary(self):
    robot = Solution()

    def reset():
      robot.x, robot.y = 0, 0
      robot.dir = 0

    robot.commands["reset"] = reset
    robot.execute("move")
    self.assertEqual(robot.position(), (0, 1))
    robot.execute("reset")
    self.assertEqual(robot.position(), (0, 0))

  def test_robot_sim_delegates_to_execute(self):
    robot = Solution()
    with patch("builtins.input", side_effect=_inputs("turn", "move")):
      result = Solution.robot_sim("")
    self.assertEqual(result, (1, 0))


if __name__ == "__main__":
  unittest.main()
